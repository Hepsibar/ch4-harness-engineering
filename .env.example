# ─────────────────────────────────────────────
#  환경변수 템플릿
#  이 파일을 복사해서 .env.local 로 만들고 값을 채우세요:
#    cp .env.example .env.local
#  .env.local 은 .gitignore 에 의해 커밋되지 않습니다.
# ─────────────────────────────────────────────

# [필수] YouTube Data API v3 키
#  - 발급: Google Cloud Console → "YouTube Data API v3" 사용 설정 → API 키 생성
#  - 용도: 내 채널 영상 조회 + 비슷한/인기 콘텐츠 검색
#  - 서버에서만 사용 (NEXT_PUBLIC_ 접두사 금지)
YOUTUBE_API_KEY=

# [필수] Anthropic(Claude) API 키 — 콘텐츠 분석 & 다음 콘텐츠 추천
#  - 발급: https://console.anthropic.com → API Keys
#  - 서버에서만 사용 (NEXT_PUBLIC_ 접두사 금지)
ANTHROPIC_API_KEY=

# [선택] 사용할 Claude 모델 (미설정 시 코드 기본값 사용)
#  - 저렴/빠름: claude-haiku-5-5  | 품질 우선: claude-sonnet-5-5
ANTHROPIC_MODEL=claude-haiku-5-5
